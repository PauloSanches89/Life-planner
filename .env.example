# Copy this file to .env and fill in the values you have. Leave a line blank until you need it.
# Accounts, connections, and the Auth0 application are created at https://manage.auth0.com/
# The application's allowed callback URL must match AUTH0_CALLBACK_URL.

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_CALLBACK_URL=http://127.0.0.1:8765/callback

# 32 bytes, base64-encoded. If this is empty, the app creates userdata/master.key, which is gitignored.
DATA_ENCRYPTION_KEY=

PORT=8765

# Local Ollama. When OLLAMA_MODEL is set, chat uses it and does not call Gemini or Azure.
# Install Ollama, run it, and pull that model. qwen3:4b fits a 16 GB PC and can call tools.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Gemini. Used when OLLAMA_MODEL is empty and GEMINI_API_KEY is set. The assistant and the checker share this key.
# A key can exist while AI Studio still says the free tier is unavailable. That status is on
# the Google Cloud project. generateContent then fails until billing is enabled for the project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Azure OpenAI. Used only when OLLAMA_MODEL and GEMINI_API_KEY are empty. The assistant deployment should be
# gpt-4o-mini. The checker is a second deployment that must allow each edit before it is saved.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_ASSISTANT_DEPLOYMENT=
AZURE_OPENAI_CHECKER_DEPLOYMENT=

# Optional. When all four are set, the same encrypted per-user item is stored in Cosmos DB
# with partition key /userId. Leave them empty to keep documents under userdata/.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=
COSMOS_CONTAINER=
