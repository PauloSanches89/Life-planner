# Copy this file to .env and fill in the values you have. Leave a line blank until you need it.
# Accounts, connections, and the Auth0 application are created at https://manage.auth0.com/
# The application's allowed callback URL must match AUTH0_CALLBACK_URL.

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_CALLBACK_URL=http://127.0.0.1:8765/callback

# 32 bytes, base64-encoded. If this is empty, the app creates userdata/master.key, which is gitignored.
DATA_ENCRYPTION_KEY=

PORT=8765

# Azure OpenAI. The assistant deployment should be gpt-4o-mini. The checker is a second deployment
# that must allow each create, edit, or delete before it is saved.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_ASSISTANT_DEPLOYMENT=
AZURE_OPENAI_CHECKER_DEPLOYMENT=

# Maps Embed API key. The map tab stays on the location text until this is set.
GOOGLE_MAPS_API_KEY=

# Optional. When all four are set, the same encrypted per-user item is stored in Cosmos DB
# with partition key /userId. Leave them empty to keep documents under userdata/.
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=
COSMOS_CONTAINER=
